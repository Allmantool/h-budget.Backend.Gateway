{
    "enabledManagers": [
        "nuget"
    ],
    "extends": [
        "config:recommended"
    ],
    "nuget": {
        "enabled": true
    },
    "defaultRegistryUrls": [
        "https://api.nuget.org/v3/index.json"
    ],
    "packageRules": [
        {
            "matchPackageNames": ["*"],
            "matchUpdateTypes": ["minor", "patch"]
        }
    ],
    "labels": [
        "Renovate-update-dependencies"
    ]
}
